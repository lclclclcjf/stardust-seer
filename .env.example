# Server-only credentials. Never prefix the key with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Per-server-instance protection. Also enable distributed limits at the hosting layer.
AI_RATE_LIMIT_MAX=5
AI_RATE_LIMIT_WINDOW_SECONDS=60
AI_RATE_LIMIT_SALT=replace-with-a-long-random-server-secret
